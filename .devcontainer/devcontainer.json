{
  "name": "Project Dev (fakecloud + stackport)",
  "dockerComposeFile": [
    "../compose.yaml",
    "docker-compose.dev.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "dockerDashComposeVersion": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [4566, 8080],
  "portsAttributes": {
    "4566": { "label": "fakecloud (AWS emulator)" },
    "8080": { "label": "stackport dashboard" }
  },
  "postCreateCommand": "chmod +x ./reset.sh && ./reset.sh || true",
  "remoteUser": "vscode"
}